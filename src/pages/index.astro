---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import { homePageContent, identity } from "../config";
import SocialLink from "../components/SocialLink.astro";
import Link from "../components/Link.astro";
---

<Layout seo={homePageContent.seo}>
  <section class="mt-10 max-w-2xl mx-auto px-6">
    <h1 class="text-3xl mb-1">{identity.name}</h1>
    <p class="opacity-60 mb-10 subtitle">{homePageContent.role}</p>
    <div class="flex flex-row flex-wrap gap-6 mb-8 items-center">
      <Image
        src={identity.logo}
        alt={identity.name}
        width={125}
        height={125}
        loading="lazy"
        decoding="async"
        quality={100}
        densities={[1.5, 2]}
        class="rounded-full"
        style="object-fit: cover; width: 125px; height: 125px;"
      />
      <div class="group flex flex-col justify-center gap-2 w-fit">
        {
          homePageContent.homeSocialLinks.map((link) => (
            <SocialLink
              title={link.title}
              url={link.url}
              icon={link.icon}
              external={link.external}
            />
          ))
        }
      </div>
    </div>
    <div class="max-w-2xl mb-8">
      <p>
        I'm a technology leader with more than two decades of coding experience. I bring technical depth, experience leading across engineering disciplines, and a strong <span class="gradient-link glowing-animation">focus on execution</span>.
      </p>
      <br/>
      <p>
        As CTO at Forcite, I led software, firmware and electrical engineering efforts, shaping strategy and supporting the design of systems that brought those disciplines together. At GoPro, my role centres on software engineering leadership, with deep involvement in firmware and contributions to electrical engineering decisions.
      </p>
      <br/>
      <p>
        I take particular pride in getting products through the final stretch to <strong>release</strong>. Turning a promising idea into something ready to ship takes persistence, sound judgement and attention to details that are easy to underestimate. I enjoy setting direction and taking responsibility for the work needed to <strong>deliver</strong> it.
      </p>
      <br/>
      <p>
        My approach to leadership centres on clear priorities, trust and helping people grow. I've been fortunate to work with brilliant people, and I care about giving them the context, support and ownership to do their best work. I still write code and keep my technical skills sharp, which helps me stay connected to the challenges my teams face.
      </p>
      <br/>
      <p>
        <strong>AI is a major focus of my work</strong>. I'm actively building with new capabilities and using them to develop business processes and rethink existing workflows. I learn by experimenting and putting ideas into practice, and I'm continually exploring how these tools can improve the way we build and operate.
      </p>
      <br/>
      <p>
        Outside of technology, my biggest interests are motorsport and gardening <i>(what a combo, <strong>right?</strong>)</i>.
      </p>
      <br/>
      <p>
        Always happy to connect with people who enjoy building things, sharing ideas and seeing them through.
      </p>
    </div>
    <div>
      <blockquote cite="https://www.huxley.net/bnw/four.html">
        <p>
          When you don't create things, you become defined by your tastes rather than ability. Your tastes only narrow & exclude people. So <strong>create</strong>.
        </p>
      </blockquote>
      <p><cite><strong>_why</strong></cite></p>
    </div>
    <div class="max-w-2xl mb-8">
      <a class="gradient-link glowing-animation" href="/about">@findyourexit</a>
    </div>
    <div class="flex items-center gap-4 group w-fit">
      {
        homePageContent.links.map((link) => (
          <Link
            text={link.title}
            href={link.url}
            external={link.external}
            icon={link.icon}
          />
        ))
      }
    </div>
  </section>
</Layout>
