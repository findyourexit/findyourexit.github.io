---
import Layout from "../layouts/Layout.astro";
import {recentlyPageContent} from "../config";
import ResumeItem from "../components/ResumeItem.astro";
---

<Layout seo={recentlyPageContent.seo}>
    <section class="mt-10 max-w-2xl mx-auto px-6">
        <h1 class="text-3xl mb-1">{recentlyPageContent.title}</h1>
        <p class="opacity-60 mb-14 subtitle">{recentlyPageContent.subtitle}</p>
    </section>

    <section class="mt-10 max-w-2xl mx-auto px-6 sm:flex sm:gap-16">
        <h2 class="mb-8 sm:mb-0 opacity-60">Work</h2>
        <div>
            <div class="mb-6">
                I've got quite a few tools in my belt, but at the moment, I'm
                particularly fond of
                <span class="gradient-link glowing-animation">Kotlin</span>, <span
                    class="gradient-link glowing-animation">Kotlin Multiplatform</span
            >, and <span class="gradient-link glowing-animation"
            >Compose Multiplatform</span
            > – <i
            >it's pretty clear that I'm jazzing in the cross-platform mobile
                engineering space, at the moment!</i
            >
            </div>
            <div class="grid grid-cols-1 group">
                {recentlyPageContent.work.items.map((item) =>
                        <ResumeItem {...item}/>)}
            </div>
        </div>
    </section>
</Layout>
